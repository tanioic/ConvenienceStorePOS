<Window x:Class="ConvenienceStorePOS.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:ConvenienceStorePOS.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProductManagementViewModel}"
        Title="商品管理 (SPEC-005)"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left: Product List -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="8,8,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="商品一覧" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Search & Filter -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="カテゴリ:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,10,0" />

                    <TextBox Grid.Column="2" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,4" Width="160" VerticalContentAlignment="Center" Margin="0,0,6,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="3" Command="{Binding SearchCommand}" Content="🔍 検索"
                            Padding="10,4" Margin="0,0,4,0" Background="#EEEEEE" BorderBrush="#CCCCCC" Cursor="Hand" />

                    <Button Grid.Column="4" Command="{Binding ClearSearchCommand}" Content="クリア"
                            Padding="8,4" Background="#FAFAFA" BorderBrush="#DDDDDD" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Product DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F9FBFF"
                      BorderBrush="{StaticResource BorderColor}"
                      BorderThickness="1,0,1,1"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionUnit="FullRow"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="JANコード" Binding="{Binding Code}" Width="140" />
                    <DataGridTextColumn Header="商品名" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="税抜単価" Binding="{Binding FormattedPriceTaxExcluded}" Width="90" />
                    <DataGridTextColumn Header="税込単価" Binding="{Binding FormattedPrice}" Width="90" />
                    <DataGridTextColumn Header="税率" Binding="{Binding TaxRateLabel}" Width="80" />
                    <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn Header="在庫" Binding="{Binding StockQuantity}" Width="50" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="12,6">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2E7D32" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: Edit Form -->
        <Grid Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <TextBlock Grid.Row="0" Text="商品編集" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,12" />

                    <!-- Form Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Code -->
                            <TextBlock Text="JANコード *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                                     FontSize="14" FontWeight="SemiBold" />

                            <!-- Name -->
                            <TextBlock Text="商品名 *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                                     FontSize="14" />

                            <!-- Price -->
                            <TextBlock Text="単価（税抜）*" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                                     FontSize="14" />

                            <!-- Tax Rate -->
                            <TextBlock Text="消費税区分 *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding TaxRateTypes}" SelectedItem="{Binding EditTaxRateType}"
                                      Padding="8,4" Margin="0,0,0,10" FontSize="13" />

                            <!-- Category -->
                            <TextBlock Text="カテゴリ *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditCategory}"
                                      Padding="8,4" Margin="0,0,0,10" FontSize="13" />

                            <!-- Stock -->
                            <TextBlock Text="在庫数" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditStockQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10"
                                     FontSize="14" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding CancelEditCommand}" Content="キャンセル"
                                Padding="16,8" Background="#EEEEEE" BorderBrush="#CCCCCC" FontSize="13" Cursor="Hand"
                                HorizontalAlignment="Left" Margin="0,0,8,0" />

                        <Button Grid.Column="1" Command="{Binding SaveProductCommand}" Content="💾 保存"
                                Padding="20,8" Background="{StaticResource AccentColor}" Foreground="White"
                                FontWeight="Bold" FontSize="13" Cursor="Hand" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Buttons (shown when not editing) -->
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20"
                VerticalAlignment="Top" Margin="0,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="操作" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,16" />

                <Button Command="{Binding StartAddNewCommand}" Padding="16,12" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                        Background="{StaticResource AccentColor}" Foreground="White" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="新規商品を追加" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding StartEditCommand}" CommandParameter="{Binding SelectedProduct}"
                        IsEnabled="{Binding HasSelectedProduct}" Padding="16,12" Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                        Background="{StaticResource PrimaryColor}" Foreground="White" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="選択商品を編集" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteProductCommand}" CommandParameter="{Binding SelectedProduct}"
                        IsEnabled="{Binding HasSelectedProduct}" Padding="16,12" FontSize="14" FontWeight="SemiBold"
                        Background="{StaticResource DangerLightColor}" Foreground="{StaticResource DangerColor}"
                        BorderBrush="{StaticResource DangerColor}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="選択商品を削除" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="商品を一覧から選択してから「編集」または「削除」を押してください。"
                           FontSize="11" Foreground="{StaticResource TextSecondaryColor}" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
