<Window x:Class="ConvenienceStorePOS.SalesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ConvenienceStorePOS.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:SalesReportViewModel}"
        Title="売上集計レポート (SPEC-006)"
        Height="750" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="8,8,0,0" Padding="16,12" Margin="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="売上集計レポート" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Date Range Selector -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="期間:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0" Width="170" />

                <TextBlock Grid.Column="2" Text="〜" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />

                <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0" Width="170" />

                <Button Grid.Column="4" Command="{Binding LoadReportCommand}" Content="🔍 集計実行"
                        Padding="14,6" Background="{StaticResource AccentColor}" Foreground="White"
                        FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetTodayCommand}" Content="今日" Padding="10,4" Margin="0,0,4,0" Background="#EEE" BorderBrush="#CCC" FontSize="12" Cursor="Hand" />
                    <Button Command="{Binding SetThisWeekCommand}" Content="今週" Padding="10,4" Margin="0,0,4,0" Background="#EEE" BorderBrush="#CCC" FontSize="12" Cursor="Hand" />
                    <Button Command="{Binding SetThisMonthCommand}" Content="今月" Padding="10,4" Margin="0,0,4,0" Background="#EEE" BorderBrush="#CCC" FontSize="12" Cursor="Hand" />
                    <Button Command="{Binding SetLastMonthCommand}" Content="先月" Padding="10,4" Background="#EEE" BorderBrush="#CCC" FontSize="12" Cursor="Hand" />
                </StackPanel>

                <TextBlock Grid.Column="6" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Grand Totals -->
        <Border Grid.Row="2" Background="#E3F2FD" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,1,1" Padding="16,10" Margin="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="売上合計（税込）" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding GrandTotalAmount, StringFormat='¥{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="消費税合計" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding GrandTotalTax, StringFormat='¥{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="取引件数" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding GrandTotalTransactions, StringFormat='{}{0}件'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="販売点数" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding GrandTotalQuantity, StringFormat='{}{0}点'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grids -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Daily Sales -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6,6,0,0" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0">
                    <TextBlock Text="📅 日別売上" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding DailySummaries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F9FBFF"
                          BorderBrush="{StaticResource BorderColor}"
                          BorderThickness="1,0,1,1"
                          CanUserAddRows="False"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100" />
                        <DataGridTextColumn Header="件数" Binding="{Binding TransactionCount}" Width="60" />
                        <DataGridTextColumn Header="点数" Binding="{Binding TotalQuantity}" Width="60" />
                        <DataGridTextColumn Header="現金" Binding="{Binding CashAmount, StringFormat='¥{0:N0}'}" Width="100" />
                        <DataGridTextColumn Header="キャッシュレス" Binding="{Binding CashlessAmount, StringFormat='¥{0:N0}'}" Width="110" />
                        <DataGridTextColumn Header="売上合計" Binding="{Binding TotalAmount, StringFormat='¥{0:N0}'}" Width="110" />
                        <DataGridTextColumn Header="消費税" Binding="{Binding TotalTax, StringFormat='¥{0:N0}'}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Category & Payment -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Category Breakdown -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="6,6,0,0" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0">
                        <TextBlock Text="📦 商品別売上" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CategorySummaries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#FFFBF5"
                              BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1,0,1,1"
                              CanUserAddRows="False"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="商品名" Binding="{Binding Category}" Width="*" />
                            <DataGridTextColumn Header="点数" Binding="{Binding TotalQuantity}" Width="60" />
                            <DataGridTextColumn Header="税抜" Binding="{Binding TotalAmountExcludingTax, StringFormat='¥{0:N0}'}" Width="100" />
                            <DataGridTextColumn Header="消費税" Binding="{Binding TotalTax, StringFormat='¥{0:N0}'}" Width="90" />
                            <DataGridTextColumn Header="税込合計" Binding="{Binding TotalAmountIncludingTax, StringFormat='¥{0:N0}'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Payment Method Breakdown -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="6,6,0,0" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0">
                        <TextBlock Text="💳 支払方法別売上" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PaymentSummaries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5FFF5"
                              BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1,0,1,1"
                              CanUserAddRows="False"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="支払方法" Binding="{Binding PaymentMethodLabel}" Width="*" />
                            <DataGridTextColumn Header="件数" Binding="{Binding TransactionCount}" Width="80" />
                            <DataGridTextColumn Header="売上合計" Binding="{Binding TotalAmount, StringFormat='¥{0:N0}'}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
