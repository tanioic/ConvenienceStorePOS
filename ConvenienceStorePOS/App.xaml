<Application x:Class="ConvenienceStorePOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ConvenienceStorePOS.Converters">
    <Application.Resources>
        <converters:TaxRateBadgeBrushConverter x:Key="TaxRateBadgeBrushConverter" />
        <converters:CurrencyFormatConverter x:Key="CurrencyFormatConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Application-wide Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1565C0" />
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#E3F2FD" />
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#0D47A1" />
        <SolidColorBrush x:Key="AccentColor" Color="#00897B" />
        <SolidColorBrush x:Key="AccentLightColor" Color="#E0F2F1" />
        <SolidColorBrush x:Key="ReducedTaxColor" Color="#2E7D32" />
        <SolidColorBrush x:Key="ReducedTaxBgColor" Color="#E8F5E9" />
        <SolidColorBrush x:Key="StandardTaxColor" Color="#1565C0" />
        <SolidColorBrush x:Key="StandardTaxBgColor" Color="#E3F2FD" />
        <SolidColorBrush x:Key="DangerColor" Color="#C62828" />
        <SolidColorBrush x:Key="DangerLightColor" Color="#FFEBEE" />
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F6F9" />
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#212121" />
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#666666" />
    </Application.Resources>
</Application>
