<Window x:Class="ConvenienceStorePOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ConvenienceStorePOS.ViewModels"
        xmlns:common="clr-namespace:ConvenienceStorePOS.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="コンビニエンスストア POSシステム - [SPEC-001 売上登録 &amp; SPEC-003 会計処理]"
        Height="820" Width="1240"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Window.InputBindings>
        <KeyBinding Key="F12" Command="{Binding OpenAccountingCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseAccountingCommand}" />
        <KeyBinding Key="F2" Command="{Binding ShowReceiptCommand}" />
        <KeyBinding Key="F3" Command="{Binding PrintReceiptCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- ==========================================
             BASE POS LAYOUT (Header, Work Area, Status Bar)
             ========================================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Main Work Area -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ==========================================
                 1. HEADER BAR
                 ========================================== -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- System Title & Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏪" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Convenience POS" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="売上登録 &amp; 会計システム (SPEC-001 / SPEC-003)" FontSize="11" Foreground="#BBDEFB" />
                        </StackPanel>
                        <Border Background="#43A047" CornerRadius="4" Padding="6,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="稼働中" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- Center / Station Info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#1E88E5" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding RegisterNumber}" FontSize="13" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Border Background="#1E88E5" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding StaffName}" FontSize="13" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- Current Clock Time -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕒" FontSize="15" Margin="0,0,6,0" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentTime}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================
                 2. MAIN WORK AREA (2-Column Layout)
                 ========================================== -->
            <Grid Grid.Row="1" Margin="14,14,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.8*" MinWidth="450" /> <!-- Left: Cart & Summary & Checkout Button -->
                    <ColumnDefinition Width="10" />                 <!-- Margin -->
                    <ColumnDefinition Width="5.2*" MinWidth="480" /> <!-- Right: Barcode & Product Grid -->
                </Grid.ColumnDefinitions>

                <!-- ==========================================
                     LEFT PANEL: Cart / Transaction Items
                     ========================================== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Cart Header & Actions -->
                        <RowDefinition Height="*" />    <!-- Cart Items List -->
                        <RowDefinition Height="Auto" /> <!-- Summary, Tax Breakdown & Checkout Button -->
                    </Grid.RowDefinitions>

                    <!-- Cart Title & Action Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0" Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒 売上明細" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource PrimaryLightColor}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalQuantity, StringFormat='{}全 {0} 点'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" />
                                </Border>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Command="{Binding ClearCartCommand}"
                                    Background="{StaticResource DangerLightColor}"
                                    BorderBrush="{StaticResource DangerColor}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource DangerColor}"
                                    Padding="12,5"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" Margin="0,0,4,0" />
                                    <TextBlock Text="全取消" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Cart List -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,1,0">
                        <Grid>
                            <!-- Items ListView -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CartItems}" Margin="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:CartItemViewModel}">
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,8" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />     <!-- Product Info & Tax -->
                                                        <ColumnDefinition Width="Auto" /> <!-- Unit Price -->
                                                        <ColumnDefinition Width="Auto" /> <!-- Quantity Controls -->
                                                        <ColumnDefinition Width="Auto" /> <!-- Subtotal -->
                                                        <ColumnDefinition Width="Auto" /> <!-- Delete Action -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Product Info -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                            <!-- Tax Badge -->
                                                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource StandardTaxBgColor}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TaxRateType}" Value="{x:Static common:TaxRateType.Reduced8}">
                                                                                <Setter Property="Background" Value="{StaticResource ReducedTaxBgColor}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding TaxRateLabel}" FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource StandardTaxColor}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TaxRateType}" Value="{x:Static common:TaxRateType.Reduced8}">
                                                                                    <Setter Property="Foreground" Value="{StaticResource ReducedTaxColor}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ProductCode, StringFormat='{}JAN: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Unit Price -->
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedUnitPrice}" FontSize="13" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center" Margin="8,0" />

                                                    <!-- Quantity Stepper -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                        <Button Command="{Binding DecreaseQuantityCommand}" Content="-" Width="28" Height="28" FontWeight="Bold" FontSize="14" Background="#EEEEEE" BorderBrush="#CCCCCC" Cursor="Hand" />
                                                        <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" MinWidth="34" Height="28" Margin="2,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Button Command="{Binding IncreaseQuantityCommand}" Content="+" Width="28" Height="28" FontWeight="Bold" FontSize="14" Background="#EEEEEE" BorderBrush="#CCCCCC" Cursor="Hand" />
                                                    </StackPanel>

                                                    <!-- Line Subtotal -->
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSubtotal}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkColor}" VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="65" TextAlignment="Right" />

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="4" Command="{Binding RemoveCommand}" Content="✕" Width="26" Height="26" Background="#FFEBEE" BorderBrush="#EF9A9A" Foreground="#C62828" FontWeight="Bold" FontSize="12" ToolTip="明細を削除" Cursor="Hand" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty Cart Guide -->
                            <Border Visibility="{Binding HasCartItems, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🛒" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4" />
                                    <TextBlock Text="商品が登録されていません" FontSize="15" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" />
                                    <TextBlock Text="バーコードを入力するか、右側の商品一覧から選択してください" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Summary & Checkout Card -->
                    <Border Grid.Row="2" Background="White" CornerRadius="0,0,8,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,1" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Tax Breakdown -->
                                <RowDefinition Height="Auto" /> <!-- Grand Total -->
                                <RowDefinition Height="Auto" /> <!-- Checkout Action Button -->
                            </Grid.RowDefinitions>

                            <!-- Tax & Subtotal Breakdown -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: 8% & 10% Breakdown -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Grid Margin="0,1">
                                        <TextBlock Text="8% 対象 (飲食料品等):" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                                        <TextBlock Text="{Binding Reduced8TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="　└ 内消費税 (8%):" FontSize="11" Foreground="{StaticResource ReducedTaxColor}" />
                                        <TextBlock Text="{Binding Reduced8TaxAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ReducedTaxColor}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="10% 対象 (日用品・雑貨):" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                                        <TextBlock Text="{Binding Standard10TaxableAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="　└ 内消費税 (10%):" FontSize="11" Foreground="{StaticResource StandardTaxColor}" />
                                        <TextBlock Text="{Binding Standard10TaxAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StandardTaxColor}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <!-- Right: Subtotal & Tax Sum -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Grid Margin="0,1">
                                        <TextBlock Text="税抜合計:" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" />
                                        <TextBlock Text="{Binding SubtotalExcludingTax, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="消費税合計:" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" />
                                        <TextBlock Text="{Binding TotalTaxAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="合計点数:" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" />
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0} 点'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Grand Total (税込合計) -->
                            <Border Grid.Row="1" Background="#F1F8E9" BorderBrush="#AED581" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="税込合計金額" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="26" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- SPEC-003 Checkout Button -->
                            <Button Grid.Row="2"
                                    Command="{Binding OpenAccountingCommand}"
                                    IsEnabled="{Binding CanOpenAccounting}"
                                    Background="{StaticResource AccentColor}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="16"
                                    Height="48"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="お会計へ進む [F12]" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==========================================
                     RIGHT PANEL: Barcode Scan & Product Catalog
                     ========================================== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Barcode Input Box -->
                        <RowDefinition Height="Auto" /> <!-- Category Selector & Search -->
                        <RowDefinition Height="*" />    <!-- Product Cards Grid -->
                    </Grid.RowDefinitions>

                    <!-- 1. Barcode Scan Box -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📷 バーコード入力 / JANコードスキャン" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Padding="10,8"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource PrimaryColor}"
                                         BorderThickness="1.5">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding RegisterByBarcodeCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="1"
                                        Command="{Binding RegisterByBarcodeCommand}"
                                        Content="登録 (Enter)"
                                        Background="{StaticResource PrimaryColor}"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="14"
                                        Padding="18,8"
                                        Margin="8,0,0,0"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. Categories & Search Filter -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Category Filter Buttons -->
                            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,6"
                                                    Margin="0,0,6,0"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="14"/>
                                                    </Style>
                                                </Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                        <Setter Property="Foreground" Value="#424242"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Keyword Search Box -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="#CCCCCC">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="1"
                                        Command="{Binding SearchCommand}"
                                        Content="🔍 検索"
                                        Padding="10,5"
                                        Margin="6,0,0,0"
                                        Background="#EEEEEE"
                                        BorderBrush="#CCCCCC"
                                        Cursor="Hand" />

                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        Content="クリア"
                                        Padding="8,5"
                                        Margin="4,0,0,0"
                                        Background="#FAFAFA"
                                        BorderBrush="#DDDDDD"
                                        Cursor="Hand" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. Touch Product Cards Grid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DisplayProducts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:ProductItemViewModel}">
                                        <Button Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="4"
                                                Width="148"
                                                Height="102"
                                                Cursor="Hand"
                                                Background="#FAFAFA"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                Padding="6"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /> <!-- Category & Tax Badge -->
                                                    <RowDefinition Height="*" />    <!-- Name -->
                                                    <RowDefinition Height="Auto" /> <!-- Price -->
                                                </Grid.RowDefinitions>

                                                <!-- Category & Tax Badge -->
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Left" />
                                                    <Border HorizontalAlignment="Right" Padding="4,1" CornerRadius="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource StandardTaxBgColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TaxRateType}" Value="{x:Static common:TaxRateType.Reduced8}">
                                                                        <Setter Property="Background" Value="{StaticResource ReducedTaxBgColor}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TaxRateLabel}" FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource StandardTaxColor}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TaxRateType}" Value="{x:Static common:TaxRateType.Reduced8}">
                                                                            <Setter Property="Foreground" Value="{StaticResource ReducedTaxColor}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <!-- Name -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,2,0,2" />

                                                <!-- Price -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding FormattedPriceTaxExcluded}" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Bottom" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding FormattedPrice}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==========================================
                 3. BOTTOM STATUS BAR
                 ========================================== -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Message -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Keyboard shortcuts guide -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EEEEEE" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="[Enter] バーコード登録" FontSize="11" Foreground="#666666" />
                        </Border>
                        <Border Background="#E0F2F1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="[F12] お会計" FontSize="11" FontWeight="Bold" Foreground="#00796B" />
                        </Border>
                        <Border Background="#EEEEEE" CornerRadius="3" Padding="6,2">
                            <TextBlock Text="[全取消] カートクリア" FontSize="11" Foreground="#666666" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================
             SPEC-003: ACCOUNTING MODAL OVERLAY (お会計ダイアログ)
             ======================================================== -->
        <Grid Background="#99000000"
              Visibility="{Binding IsAccountingModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="12"
                    Width="780"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Modal Header -->
                        <RowDefinition Height="*" />    <!-- Modal Body -->
                        <RowDefinition Height="Auto" /> <!-- Modal Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="お会計・決済処理" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseAccountingCommand}"
                                Content="✕"
                                FontSize="18"
                                FontWeight="Bold"
                                Width="32" Height="32"
                                Background="#F5F5F5"
                                BorderBrush="#E0E0E0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Body (Payment Methods & Calculator) -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Total Amount Banner -->
                            <RowDefinition Height="Auto" /> <!-- Payment Method Tabs -->
                            <RowDefinition Height="*" />    <!-- Payment Method Content (Cash Keypad vs Cashless info) -->
                        </Grid.RowDefinitions>

                        <!-- Total Amount Banner -->
                        <Border Grid.Row="0" Background="#F1F8E9" BorderBrush="#AED581" BorderThickness="1.5" CornerRadius="8" Padding="16,10" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="ご請求金額 (税込)" FontSize="15" FontWeight="SemiBold" Foreground="#1B5E20" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="30" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Payment Method Tabs -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cash Tab -->
                            <Button Grid.Column="0"
                                    Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="{x:Static common:PaymentMethod.Cash}"
                                    Margin="0,0,4,0"
                                    Height="44"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.Cash}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💴 "/>
                                    <TextBlock Text="現金"/>
                                </StackPanel>
                            </Button>

                            <!-- Credit Card Tab -->
                            <Button Grid.Column="1"
                                    Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="{x:Static common:PaymentMethod.CreditCard}"
                                    Margin="2,0,2,0"
                                    Height="44"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.CreditCard}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳 "/>
                                    <TextBlock Text="クレジット"/>
                                </StackPanel>
                            </Button>

                            <!-- Electronic Money Tab -->
                            <Button Grid.Column="2"
                                    Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="{x:Static common:PaymentMethod.ElectronicMoney}"
                                    Margin="2,0,2,0"
                                    Height="44"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.ElectronicMoney}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📱 "/>
                                    <TextBlock Text="電子マネー"/>
                                </StackPanel>
                            </Button>

                            <!-- QR Code Tab -->
                            <Button Grid.Column="3"
                                    Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="{x:Static common:PaymentMethod.QrCode}"
                                    Margin="4,0,0,0"
                                    Height="44"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.QrCode}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📲 "/>
                                    <TextBlock Text="バーコード/QR"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Main Content Area based on Payment Method -->
                        <Grid Grid.Row="2">
                            <!-- CASH PAYMENT VIEW -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.Cash}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" /> <!-- Amounts & Change -->
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="1.1*" /> <!-- Keypad & Quick Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Left: Received Amount & Change Details -->
                                <StackPanel Grid.Column="0">
                                    <!-- Received Amount Box -->
                                    <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="お預かり金額" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}" />
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="¥" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding ReceivedAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="24"
                                                         FontWeight="Bold"
                                                         Foreground="{StaticResource PrimaryColor}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Margin="22,0,0,0"
                                                         VerticalContentAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Change Amount Box -->
                                    <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Setter Property="BorderBrush" Value="#81C784"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaymentAllowed}" Value="False">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                        <Setter Property="BorderBrush" Value="#E57373"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="お釣り" FontSize="13" FontWeight="Bold" Foreground="#2E7D32">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaymentAllowed}" Value="False">
                                                                    <Setter Property="Text" Value="不足額" />
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" FontSize="24" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ChangeAmount, Converter={StaticResource CurrencyFormatConverter}}" />
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaymentAllowed}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding ShortageAmount, Converter={StaticResource CurrencyFormatConverter}}" />
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Currency Breakdown Text -->
                                            <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding ChangeBreakdownText, StringFormat='{}金種内訳: {0}'}" FontSize="11" Foreground="#555555" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Touch 10-Key Pad & Quick Buttons -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Quick Buttons -->
                                        <RowDefinition Height="*" />    <!-- Keypad Grid -->
                                    </Grid.RowDefinitions>

                                    <!-- Quick Amount Buttons -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Command="{Binding QuickCashCommand}" CommandParameter="Exact" Content="ちょうど" Margin="0,0,2,0" Height="34" FontSize="11" FontWeight="Bold" Background="#ECEFF1" BorderBrush="#CFD8DC" Cursor="Hand" />
                                        <Button Grid.Column="1" Command="{Binding QuickCashCommand}" CommandParameter="1000" Content="千円" Margin="2,0,2,0" Height="34" FontSize="11" FontWeight="Bold" Background="#ECEFF1" BorderBrush="#CFD8DC" Cursor="Hand" />
                                        <Button Grid.Column="2" Command="{Binding QuickCashCommand}" CommandParameter="5000" Content="5千円" Margin="2,0,2,0" Height="34" FontSize="11" FontWeight="Bold" Background="#ECEFF1" BorderBrush="#CFD8DC" Cursor="Hand" />
                                        <Button Grid.Column="3" Command="{Binding QuickCashCommand}" CommandParameter="10000" Content="1万円" Margin="2,0,0,0" Height="34" FontSize="11" FontWeight="Bold" Background="#ECEFF1" BorderBrush="#CFD8DC" Cursor="Hand" />
                                    </Grid>

                                    <!-- 10-Key Pad -->
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 0: 7, 8, 9, BS -->
                                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding InputKeypadCommand}" CommandParameter="7" Content="7" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="0" Grid.Column="1" Command="{Binding InputKeypadCommand}" CommandParameter="8" Content="8" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="0" Grid.Column="2" Command="{Binding InputKeypadCommand}" CommandParameter="9" Content="9" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="0" Grid.Column="3" Command="{Binding InputKeypadCommand}" CommandParameter="BS" Content="⌫" Margin="2" FontSize="16" FontWeight="Bold" Background="#FFEBEE" Foreground="#C62828" Cursor="Hand" />

                                        <!-- Row 1: 4, 5, 6, C -->
                                        <Button Grid.Row="1" Grid.Column="0" Command="{Binding InputKeypadCommand}" CommandParameter="4" Content="4" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding InputKeypadCommand}" CommandParameter="5" Content="5" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="1" Grid.Column="2" Command="{Binding InputKeypadCommand}" CommandParameter="6" Content="6" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="1" Grid.Column="3" Command="{Binding InputKeypadCommand}" CommandParameter="C" Content="C" Margin="2" FontSize="16" FontWeight="Bold" Background="#FFEBEE" Foreground="#C62828" Cursor="Hand" />

                                        <!-- Row 2: 1, 2, 3, +1000 -->
                                        <Button Grid.Row="2" Grid.Column="0" Command="{Binding InputKeypadCommand}" CommandParameter="1" Content="1" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="2" Grid.Column="1" Command="{Binding InputKeypadCommand}" CommandParameter="2" Content="2" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="2" Grid.Column="2" Command="{Binding InputKeypadCommand}" CommandParameter="3" Content="3" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="2" Grid.Column="3" Command="{Binding QuickCashCommand}" CommandParameter="+1000" Content="+千円" Margin="2" FontSize="11" FontWeight="Bold" Background="#E8EAF6" Foreground="#283593" Cursor="Hand" />

                                        <!-- Row 3: 0, 00, +5000, +10000 -->
                                        <Button Grid.Row="3" Grid.Column="0" Command="{Binding InputKeypadCommand}" CommandParameter="0" Content="0" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="3" Grid.Column="1" Command="{Binding InputKeypadCommand}" CommandParameter="00" Content="00" Margin="2" FontSize="18" FontWeight="Bold" Background="#FAFAFA" Cursor="Hand" />
                                        <Button Grid.Row="3" Grid.Column="2" Command="{Binding QuickCashCommand}" CommandParameter="+5000" Content="+5千" Margin="2" FontSize="11" FontWeight="Bold" Background="#E8EAF6" Foreground="#283593" Cursor="Hand" />
                                        <Button Grid.Row="3" Grid.Column="3" Command="{Binding QuickCashCommand}" CommandParameter="+10000" Content="+1万" Margin="2" FontSize="11" FontWeight="Bold" Background="#E8EAF6" Foreground="#283593" Cursor="Hand" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- CASHLESS PAYMENT VIEW (Credit Card / E-Money / QR) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static common:PaymentMethod.Cash}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📲" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBlock Text="キャッシュレス決済端末を操作してください" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center" />
                                        <TextBlock Text="お客様のカード・電子マネー・コードを端末にタッチ/スキャンしてください。" FontSize="13" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                                        <Border Background="#E8F5E9" BorderBrush="#AED581" BorderThickness="1" CornerRadius="6" Padding="16,8" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TotalAmount, StringFormat='{}決済金額: ¥{0:N0} (全額決済)'}" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Footer: Actions & Errors -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Error Message -->
                        <TextBlock Grid.Column="0" Text="{Binding PaymentErrorMessage}" FontSize="13" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center" />

                        <!-- Cancel Button -->
                        <Button Grid.Column="1"
                                Command="{Binding CloseAccountingCommand}"
                                Content="戻る (Esc)"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="#EEEEEE"
                                BorderBrush="#CCCCCC"
                                Cursor="Hand" />

                        <!-- Confirm Payment Button -->
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmPaymentCommand}"
                                IsEnabled="{Binding IsPaymentAllowed}"
                                Content="確定 (会計完了)"
                                Padding="28,10"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="{StaticResource AccentColor}"
                                Foreground="White"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================
             SPEC-003: TRANSACTION COMPLETED MODAL (会計完了ダイアログ)
             ======================================================== -->
        <Grid Background="#99000000"
              Visibility="{Binding IsTransactionCompletedModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="12"
                    Width="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
                </Border.Effect>

                <StackPanel>
                    <!-- Success Icon & Title -->
                    <TextBlock Text="🎉" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="お会計が完了しました" FontSize="22" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CompletedTransaction.TransactionNumber, StringFormat='{}取引番号: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,16" />

                    <!-- Receipt Summary Card -->
                    <Border Background="#F9FBF9" BorderBrush="#C8E6C9" BorderThickness="1.5" CornerRadius="8" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="支払方法:" FontSize="13" Foreground="{StaticResource TextSecondaryColor}" />
                                <TextBlock Text="{Binding CompletedTransaction.PaymentMethod, Converter={StaticResource CurrencyFormatConverter}}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="合計点数:" FontSize="13" Foreground="{StaticResource TextSecondaryColor}" />
                                <TextBlock Text="{Binding CompletedTransaction.TotalQuantity, StringFormat='{}{0} 点'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="ご請求金額 (税込):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" />
                                <TextBlock Text="{Binding CompletedTransaction.TotalAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="お預かり金額:" FontSize="14" Foreground="{StaticResource TextSecondaryColor}" />
                                <TextBlock Text="{Binding CompletedTransaction.ReceivedAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>

                            <Separator Background="#C8E6C9" Margin="0,8" />

                            <!-- Change Banner -->
                            <Grid Margin="0,2">
                                <TextBlock Text="お釣り金額" FontSize="18" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CompletedTransaction.ChangeAmount, Converter={StaticResource CurrencyFormatConverter}}" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Breakdown of Bills and Coins -->
                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ChangeBreakdownText, StringFormat='{}金種内訳: {0}'}" FontSize="11" Foreground="#424242" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Next Customer Action Button -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Receipt View Button -->
                        <Button Grid.Column="0"
                                Command="{Binding ShowReceiptCommand}"
                                Height="50"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="#EEEEEE"
                                BorderBrush="#CCCCCC"
                                Foreground="#333333"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="レシートを表示 [F2]" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Next Transaction Button -->
                        <Button Grid.Column="1"
                                Command="{Binding FinishTransactionCommand}"
                                Height="50"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="{StaticResource AccentColor}"
                                Foreground="White"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================
             SPEC-004: RECEIPT PREVIEW MODAL (レシートプレビューダイアログ)
             ======================================================== -->
        <Grid Background="#99000000"
              Visibility="{Binding IsReceiptModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="12"
                    Width="500"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Modal Header -->
                        <RowDefinition Height="*" />    <!-- Receipt Preview -->
                        <RowDefinition Height="Auto" /> <!-- Modal Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="レシートプレビュー" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseReceiptCommand}"
                                Content="✕"
                                FontSize="18"
                                FontWeight="Bold"
                                Width="32" Height="32"
                                Background="#F5F5F5"
                                BorderBrush="#E0E0E0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Receipt Preview Content -->
                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,12"
                            MaxHeight="460">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding ReceiptText}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="12"
                                       Foreground="#333333"
                                       TextWrapping="NoWrap"
                                       xml:space="preserve"
                                       LineHeight="16" />
                        </ScrollViewer>
                    </Border>

                    <!-- Footer: Print & Close Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Close Button -->
                        <Button Grid.Column="0"
                                Command="{Binding CloseReceiptCommand}"
                                Content="閉じる"
                                Height="44"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="#EEEEEE"
                                BorderBrush="#CCCCCC"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                Padding="20,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Print Button -->
                        <Button Grid.Column="1"
                                Command="{Binding PrintReceiptCommand}"
                                Height="44"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="{StaticResource PrimaryColor}"
                                Foreground="White"
                                Cursor="Hand"
                                Padding="20,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="印刷 [F3]" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
